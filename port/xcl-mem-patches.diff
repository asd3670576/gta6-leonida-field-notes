+    fn a_failed_commit_keeps_the_page_lazy_and_says_so() {
+        unsafe {
+            let r = VirtualAlloc(std::ptr::null(), PAGE, MEM_RESERVE, PAGE_READWRITE) as usize;
+            assert_ne!(r, 0);
+            VirtualFree(r as *mut c_void, 0, MEM_RELEASE);
+            mark(r);
