+/// For the crash line: one clause naming the failed lazy commits, empty when there were none.
+/// No allocation and no lock on the normal path.
+pub fn failure_note() -> String {
+    let n = FAILED.load(Ordering::Relaxed);
+    if n == 0 {
+        return String::new();
+    }
+    let page = LAST_PAGE.load(Ordering::Relaxed);
+    let err = LAST_ERROR.load(Ordering::Relaxed);
+    // 1455 = ERROR_COMMITMENT_LIMIT, the one a title near the commit limit runs into.
+    let why = if err == 1455 { " ERROR_COMMITMENT_LIMIT" } else { "" };
+    format!(" | lazy page commit failed {n} time(s), last {page:#x} err {err}{why}")
+}
